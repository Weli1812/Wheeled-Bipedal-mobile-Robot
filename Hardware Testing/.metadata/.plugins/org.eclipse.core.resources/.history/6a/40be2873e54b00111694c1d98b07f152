 * PLL LOOKUP TABLE (Targeting 480MHz)
 * ============================================================================ */
#if   HSE_FREQ_MHZ == 25
  #define PLL_M  5
  #define PLL_N  192
#elif HSE_FREQ_MHZ == 24
  #define PLL_M  4
  #define PLL_N  160
#elif HSE_FREQ_MHZ == 16
