/* ============================================================================
 * V3.03 PROTOCOL LOW-LEVEL COMMUNICATIONS
 * ============================================================================ */

/**
  * @brief Calculates Modbus CRC16
  */
uint16_t CRC16_Modbus(uint8_t *data, uint16_t length)
{
    uint16_t crc = 0xFFFF;
    for (uint16_t pos = 0; pos < length; pos++) {
        crc ^= (uint16_t)data[pos];
        for (int i = 8; i != 0; i--) {
            if ((crc & 0x0001) != 0) {
                crc >>= 1;
                crc ^= 0xA001;
            } else {
                crc >>= 1;
            }
        }
    }
    return crc;
}

/**
  * @brief Robust Transaction: Sends a frame and safely consumes the response
  * to prevent STM32 HAL UART Overrun lockups.
  */
static HAL_StatusTypeDef RS485_Transaction(uint8_t id, uint8_t cmd,
                                           uint8_t *tx_data, uint8_t tx_len,
                                           uint8_t *rx_buf, uint16_t expected_rx_len)
{
    uint8_t frame[64];

    // Build Header
    frame[0] = 0xAE;
    frame[1] = packet_seq++;
    frame[2] = id;
    frame[3] = cmd;
    frame[4] = tx_len;

    if (tx_len > 0 && tx_data != NULL) {
        memcpy(&frame[5], tx_data, tx_len);
    }

    // Calculate CRC
    uint16_t crc = CRC16_Modbus(frame, 5 + tx_len);
    frame[5 + tx_len] = (uint8_t)(crc & 0xFF);
    frame[6 + tx_len] = (uint8_t)((crc >> 8) & 0xFF);

    // CRITICAL FIX: Forcefully abort any stuck UART states
    if (huart1.gState != HAL_UART_STATE_READY)   HAL_UART_AbortTransmit(&huart1);
    if (huart1.RxState != HAL_UART_STATE_READY)  HAL_UART_AbortReceive(&huart1);

    // Clear error flags and flush hardware buffer
    __HAL_UART_CLEAR_FLAG(&huart1, UART_CLEAR_OREF | UART_CLEAR_NEF | UART_CLEAR_PEF | UART_CLEAR_FEF);
    __HAL_UART_SEND_REQ(&huart1, UART_RXDATA_FLUSH_REQUEST);

    // Transmit
    HAL_StatusTypeDef status = HAL_UART_Transmit(&huart1, frame, 7 + tx_len, 50);
    if (status != HAL_OK) return status;

    // Receive the expected response (Broadcast ID 0x00 does not reply)
    if (expected_rx_len > 0 && rx_buf != NULL && id != 0x00) {
        status = HAL_UART_Receive(&huart1, rx_buf, expected_rx_len, 50);
    }

    return status;
}

/* ============================================================================
 * MOTOR COMMANDS
 * ============================================================================ */

/**
  * @brief Command 0x0F: Clear Faults (Replies with 8 bytes)
  */
void Motor_ClearFault(uint8_t id)
{
    uint8_t rx_buf[8];
    RS485_Transaction(id, 0x0F, NULL, 0, rx_buf, 8);
    HAL_Delay(50); // Give the drive internal processor time to reset states
}

/**
  * @brief Command 0x25: Position & Speed Control (Replies with 29 bytes)
  */
void Motor_SetPositionSpeed(uint8_t id, float position_deg, float speed_rpm)
{
    uint8_t payload[9];
    uint8_t rx_buf[29]; // We must catch the 29-byte response to keep the bus clean

    int32_t counts = (int32_t)((position_deg / 360.0f) * COUNTS_PER_REV);
    uint32_t speed_unit = (uint32_t)(speed_rpm * 100.0f);

    payload[0] = 0x00; // 0x00 = Absolute position mode

    payload[1] = (uint8_t)((counts >>  0) & 0xFF);
    payload[2] = (uint8_t)((counts >>  8) & 0xFF);
    payload[3] = (uint8_t)((counts >> 16) & 0xFF);
    payload[4] = (uint8_t)((counts >> 24) & 0xFF);

    payload[5] = (uint8_t)((speed_unit >>  0) & 0xFF);
    payload[6] = (uint8_t)((speed_unit >>  8) & 0xFF);
    payload[7] = (uint8_t)((speed_unit >> 16) & 0xFF);
    payload[8] = (uint8_t)((speed_unit >> 24) & 0xFF);

    RS485_Transaction(id, 0x25, payload, 9, rx_buf, 29);
}

/**
  * @brief Command 0x0B: Read Real-Time Data (Replies with 29 bytes)
  */
float Motor_ReadRPM(uint8_t id)
{
    uint8_t rx_buf[29];

    // Broadcast ID cannot be read from
    if (id == 0x00) return 0.0f;

    if (RS485_Transaction(id, 0x0B, NULL, 0, rx_buf, 29) == HAL_OK)
    {
        // Verify response header is 0xAC and Command is 0x0B
        if (rx_buf[0] == 0xAC && rx_buf[3] == 0x0B)
        {
            int32_t speed_raw;
            memcpy(&speed_raw, &rx_buf[11], 4); // Bytes 11-14 contain mechanical speed
            return (float)speed_raw / 100.0f;
        }
    }
    return current_rpm; // Return last known if comms dropped
}

/* ============================================================================
 * MAIN
 * ============================================================================ */

int main(void)
{
    MPU_Config();
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART1_UART_Init();

    /* Let the motor driver board boot up */
    HAL_Delay(1500);

    /* Send Clear Fault twice just to guarantee the drive is unlocked */
    Motor_ClearFault(MOTOR_ID);
    Motor_ClearFault(MOTOR_ID);

    while (1)
    {
        // 1. Move to +90 degrees at 150 RPM
        Motor_SetPositionSpeed(MOTOR_ID, 90.0f, RATED_SPEED_RPM);

        // 2. Poll RPM 20 times (2 seconds total)
        for(int i = 0; i < 20; i++) {
            current_rpm = Motor_ReadRPM(MOTOR_ID);
            HAL_Delay(100);
        }

        // 3. Return to 0 degrees at 150 RPM
        Motor_SetPositionSpeed(MOTOR_ID, 0.0f, RATED_SPEED_RPM);

        // 4. Poll RPM 20 times (2 seconds total)
        for(int i = 0; i < 20; i++) {
            current_rpm = Motor_ReadRPM(MOTOR_ID);
            HAL_Delay(100);
        }
    }
}

